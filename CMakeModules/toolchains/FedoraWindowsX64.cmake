# Fedora MinGW RPMs can be extracted into .cache/windows-sdk without root.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(CITROSIS_WINDOWS_SDK "${CMAKE_CURRENT_LIST_DIR}/../../.cache/windows-sdk" ABSOLUTE)
set(CITROSIS_MINGW_ROOT "${CITROSIS_WINDOWS_SDK}/usr/x86_64-w64-mingw32/sys-root/mingw")
set(CMAKE_C_COMPILER "${CITROSIS_WINDOWS_SDK}/usr/bin/x86_64-w64-mingw32-gcc")
set(CMAKE_CXX_COMPILER "${CITROSIS_WINDOWS_SDK}/usr/bin/x86_64-w64-mingw32-g++")
set(CMAKE_RC_COMPILER "${CITROSIS_WINDOWS_SDK}/usr/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${CITROSIS_MINGW_ROOT}")
set(CMAKE_PREFIX_PATH "${CITROSIS_MINGW_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(QT_HOST_PATH /usr CACHE PATH "Native Qt tools prefix")
set(QT_HOST_PATH_CMAKE_DIR /usr/lib64/cmake CACHE PATH "Native Qt CMake packages")
set(QT_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_FILE}" CACHE FILEPATH "Qt cross toolchain")
set(ENV{PKG_CONFIG_LIBDIR} "${CITROSIS_MINGW_ROOT}/lib/pkgconfig:${CITROSIS_MINGW_ROOT}/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CITROSIS_WINDOWS_SDK}")
