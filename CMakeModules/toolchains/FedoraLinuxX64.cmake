set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(CITROSIS_LINUX_SDK "${CMAKE_CURRENT_LIST_DIR}/../../.cache/linux-x86_64-sdk" ABSOLUTE)
set(CMAKE_SYSROOT "${CITROSIS_LINUX_SDK}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_ASM_COMPILER_TARGET x86_64-redhat-linux-gnu)
set(CMAKE_ASM_FLAGS_INIT "--target=x86_64-redhat-linux-gnu")
set(CMAKE_C_COMPILER_TARGET x86_64-redhat-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET x86_64-redhat-linux-gnu)
set(CMAKE_C_FLAGS_INIT "--gcc-toolchain=${CITROSIS_LINUX_SDK}/usr")
set(CMAKE_CXX_FLAGS_INIT "--gcc-toolchain=${CITROSIS_LINUX_SDK}/usr")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH "${CITROSIS_LINUX_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(QT_HOST_PATH /usr CACHE PATH "Native Qt tools")
set(QT_HOST_PATH_CMAKE_DIR /usr/lib64/cmake CACHE PATH "Native Qt tools CMake")
set(ENV{PKG_CONFIG_LIBDIR} "${CITROSIS_LINUX_SDK}/usr/lib64/pkgconfig:${CITROSIS_LINUX_SDK}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CITROSIS_LINUX_SDK}")
